generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DOCTOR
  PARENT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  UNKNOWN
}

enum VaccinationStatus {
  SCHEDULED
  ADMINISTERED
  MISSED
  OVERDUE
  SKIPPED
}

enum NotificationType {
  VACCINATION_REMINDER
  VACCINATION_OVERDUE
  VACCINATION_COMPLETED
  SYSTEM
}

model User {
  id                    String         @id @default(cuid())
  email                 String         @unique
  passwordHash          String
  role                  Role
  name                  String
  phone                 String?
  isVerified            Boolean        @default(false)
  verificationToken     String?
  resetPasswordToken    String?
  resetPasswordExpires  DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  doctor                Doctor?
  parent                Parent?
  notifications         Notification[]
  refreshTokens         RefreshToken[]
}

model Doctor {
  id                 String              @id @default(cuid())
  userId             String              @unique
  licenseNumber      String              @unique
  specialization     String
  clinicName         String?
  address            String?
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedChildren   Child[]             @relation("AssignedDoctor")
  vaccinationRecords VaccinationRecord[]
}

model Parent {
  id               String  @id @default(cuid())
  userId           String  @unique
  address          String?
  emergencyContact String?
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  children         Child[]
}

model Child {
  id                 String              @id @default(cuid())
  parentId           String
  name               String
  dateOfBirth        DateTime
  gender             Gender
  bloodGroup         BloodGroup          @default(UNKNOWN)
  birthWeight        Float?
  allergies          String?
  medicalNotes       String?
  assignedDoctorId   String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  parent             Parent              @relation(fields: [parentId], references: [id], onDelete: Cascade)
  assignedDoctor     Doctor?             @relation("AssignedDoctor", fields: [assignedDoctorId], references: [id])
  vaccinationRecords VaccinationRecord[]
}

model Vaccine {
  id                   String              @id @default(cuid())
  name                 String
  description          String?
  recommendedAgeMonths Float
  doseNumber           Int                 @default(1)
  isMandatory          Boolean             @default(true)
  sideEffects          String?
  precautions          String?
  schedule             String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  vaccinationRecords   VaccinationRecord[]
}

model VaccinationRecord {
  id                     String            @id @default(cuid())
  childId                String
  vaccineId              String
  scheduledDate          DateTime
  administeredDate       DateTime?
  administeredByDoctorId String?
  batchNumber            String?
  status                 VaccinationStatus @default(SCHEDULED)
  notes                  String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  child                  Child             @relation(fields: [childId], references: [id], onDelete: Cascade)
  vaccine                Vaccine           @relation(fields: [vaccineId], references: [id])
  administeredByDoctor   Doctor?           @relation(fields: [administeredByDoctorId], references: [id])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
